# ==============================================================================
# BeautyBid Backend Production Environment Variables
# Populate these variables in your hosting provider (Render, Railway, Fly.io, etc.)
# NEVER commit actual production secrets to source control.
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=production
PORT=5000

# Primary PostgreSQL Connection URL with Connection Pooling (PgBouncer)
# Format: postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=20&pool_timeout=10
DATABASE_URL="postgresql://postgres.xxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"

# Direct PostgreSQL Connection URL (Bypasses PgBouncer for migrations & schema sync)
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL="postgresql://postgres.xxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# JWT Authentication Secrets (Generate with: openssl rand -base64 64)
JWT_SECRET="replace_with_64_byte_cryptographically_secure_random_string"
JWT_EXPIRES_IN="7d"

# Allowed Production Frontend Origin (Must match exact frontend domain without trailing slash)
FRONTEND_URL="https://beautybid.in"

# Razorpay Test Mode Credentials (For production verification prior to live KYC)
# Obtain from Razorpay Dashboard -> Settings -> API Keys (Generate in Test Mode)
RAZORPAY_KEY_ID="rzp_test_YOUR_TEST_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_TEST_KEY_SECRET"

# Razorpay Webhook Secret (Configured in Razorpay Dashboard -> Webhooks)
# Set Webhook URL to: https://api.beautybid.in/api/payments/webhook
# Subscribe to: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET="YOUR_CONFIGURED_WEBHOOK_SECRET"

# Platform Ranking Economics Settings
DEFAULT_MIN_RANK_INCREMENT=500
CURRENCY=INR
