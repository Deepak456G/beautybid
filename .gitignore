# ==============================================================================
# BeautyBid Root Git Ignore
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment variables & secrets (CRITICAL - NEVER COMMIT)
.env
.env.*
!.env.example
!.env.production.example

# Production build artifacts
dist/
build/
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Tests & Coverage
coverage/
*.lcov
.nyc_output

# Temporary files & caches
.cache/
tmp/
temp/
