# ==============================================================================
# BeautyBid Frontend Production Environment Variables
# Populate these variables in your hosting provider (Vercel, Cloudflare Pages, etc.)
# ==============================================================================

# Public API Base URL (Must match your deployed backend production URL)
# Example: https://api.beautybid.in/api
VITE_API_URL="https://api.beautybid.in/api"

# Razorpay Test Public Key ID (Safe to expose on client; used to initialize checkout modal)
# Must match backend RAZORPAY_KEY_ID in Test Mode
VITE_RAZORPAY_KEY_ID="rzp_test_YOUR_TEST_KEY_ID"

# Platform Metadata
VITE_APP_NAME="BeautyBid"
VITE_APP_DESCRIPTION="India's First Promotional Beauty Ranking Platform"
